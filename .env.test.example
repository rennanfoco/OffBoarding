# Copie para .env.test antes de rodar `npm test`.
#
# Suba o Postgres descartável de teste com:
#   docker compose -f docker-compose.test.yml up -d

DATABASE_URL=postgresql://offboarding:offboarding@localhost:5433/offboarding_test

# Não precisa ser um segredo forte — é só usado pelos testes.
AUTH_SECRET=segredo-de-teste-nao-usar-em-producao
