# ─── Banco de dados (PostgreSQL) ──────────────────────────────────────────────
# Dev local / Docker:
# DATABASE_URL=postgresql://offboarding:offboarding@localhost:5432/offboarding
#
# Produção (RDS):
# DATABASE_URL=postgresql://usuario:senha@endpoint.rds.amazonaws.com:5432/offboarding
DATABASE_URL=postgresql://offboarding:offboarding@localhost:5432/offboarding

# ─── TOTVS RM ─────────────────────────────────────────────────────────────────
TOTVS_RM_CPF_URL=https://seu-servidor.rm.cloudtotvs.com.br:8051/api/framework/v1/consultaSQLServer/RealizaConsulta/API.02/1/P
TOTVS_RM_USERNAME=seu_usuario_totvs
TOTVS_RM_PASSWORD=sua_senha_totvs

# ─── Autenticação da área de consulta ─────────────────────────────────────────
# Login é por usuário individual (tabela `usuarios`), não mais um usuário/senha
# fixo aqui. Crie o primeiro administrador de um dos dois jeitos:
#
# 1) Manualmente, rodando localmente (precisa de terminal com acesso ao banco):
#      DATABASE_URL="..." node scripts/seed-admin.mjs usuario senha
#
# 2) Automaticamente, sem terminal: defina as duas variáveis abaixo no ambiente
#    de produção. O próprio app cria esse admin sozinho na primeira vez que
#    sobe contra um banco com a tabela `usuarios` vazia (não faz nada se já
#    existir algum usuário). Pode deixar configurado permanentemente.
# BOOTSTRAP_ADMIN_USERNAME=usuario
# BOOTSTRAP_ADMIN_PASSWORD=senha

# Chave usada para assinar o cookie de sessão — use uma string longa e aleatória em produção
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=troque-por-uma-string-aleatoria-longa
